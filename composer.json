{
    "name": "andrewskm/lavacharts",
    "description": "PHP wrapper library for the Google Chart API",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "nesbot/carbon": ">=3.0 <6.0"
    },
    "autoload": {
        "psr-4": {
            "Andrewskm\\Lavacharts\\": "src/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "~13.1.4",
        "mockery/mockery": "~1.6.12",
        "squizlabs/php_codesniffer": "~4.0.1",
        "satooshi/php-coveralls": "~v2.2.0",
        "codeclimate/php-test-reporter": "~v0.4.4"
    },
    "autoload-dev": {
        "psr-4": {
            "Andrewskm\\Lavacharts\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit -c phpunit.xml",
        "cs": "phpcs --standard=PSR2 src tests",
        "cbf" : "phpcbf --standard=PSR2 src tests",
        "version": "php -r \"require(__DIR__.\\\"/src/Lavacharts.php\\\");echo \\Andrewskm\\Lavacharts\\Lavacharts::VERSION;\"",
        "lavajs:release" : "gulp --cwd javascript release && git add javascript/dist/lava.js && git commit -m 'Releasing new build of the lava.js module' && git push",
        "lavajs:gulp" : "gulp --cwd javascript",
        "lavajs:pull" : "git subtree --prefix=javascript pull lavajs master",
        "lavajs:push" : "git subtree --prefix=javascript push lavajs master"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Andrewskm\\Lavacharts\\Laravel\\LavachartsServiceProvider"
            ],
            "aliases": {
                "Lava": "Andrewskm\\Lavacharts\\Laravel\\LavachartsFacade"
            }
        }
    },
    "config": {
        "platform": {
            "php": "8.3"
        }
    },
    "minimum-stability": "stable"
}
